{
  "name": "email-classify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "oxlint",
    "test": "vitest run && bun run typecheck",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target ES2022 --ignoreConfig tests/core/ports.type-test.ts"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@microsoft/microsoft-graph-types": "2.43.1",
    "@typesafe-ai/sdk": "0.6.0",
    "age-encryption": "0.3.1",
    "better-sqlite3": "9.6.0",
    "commander": "15.0.0",
    "googleapis": "184.0.0",
    "js-yaml": "5.4.3",
    "keytar": "7.9.0",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/js-yaml": "4.0.9",
    "@types/keytar": "4.4.2",
    "@types/node": "20.19.43",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
