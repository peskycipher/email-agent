# email-classify — template. Copy a real copy into your shell env (~/.bash.d/apiKeys
# already carries TYPESAFE_API_KEY); never commit a filled-out file (`.env.*` is gitignored).

# TypeSafe (Jev) API key — the default ModelConfig.apiKeyEnvVar (provider "jev").
TYPESAFE_API_KEY=

# OpenAI API key — only needed if provider is "openai"/"custom" and config.apiKeyEnvVar
# names a var like this one.
OPENAI_API_KEY=

# Gmail OAuth client secret — each account's ~/.config/email-classify/accounts/gmail/<name>.yaml
# references it by name via `clientSecretEnvVar`.
GOOGLE_CLIENT_SECRET=

# Passphrase for the age-encrypted token fallback — only used when the OS keychain is
# unavailable and stdin is not a TTY (e.g. cron mode).
EMAIL_CLASSIFY_TOKEN_FALLBACK_PASSPHRASE=