# Copy to .env and fill with real values, then load it:
#   set -a; source .env; set +a

# Required
MAILBOX_ACCOUNT=pilot@example.com
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-client-id
M365_CLIENT_SECRET=your-client-secret
TYPESAFE_API_KEY=your-typesafe-api-key
OLLAMA_API_KEY=your-ollama-api-key

# Optional overrides
# TYPESAFE_API_URL=https://api.typesafe.ai
# EMAIL_CLEANUP_CONFIG=./config.json
# DATA_DIR=./data
# AUDIT_LOG_PATH=./data/audit.jsonl
# VIP_SENDERS=ceo@example.com,lawyer@example.com
# FINANCE_LEGAL_KEYWORDS=invoice,contract,tax,legal,payment
# RECENT_DAYS=7
# CONFIDENCE_THRESHOLD=0.7
